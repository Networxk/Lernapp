    {
      "id": "musterung-1-001",
      "deckId": "musterung-stapel-1",
      "front": "Wann wurde die Bundeswehr gegründet?",
      "back": "Am 12. November 1955.",
      "box": 1,
      "due": 0,
      "created": 1763164801001,
      "updated": 1763164801001
    },
    {
      "id": "musterung-1-002",
      "deckId": "musterung-stapel-1",
      "front": "Wer hat in Friedenszeiten die Befehls- und Kommandogewalt über die Bundeswehr?",
      "back": "Der/die Bundesminister/in der Verteidigung (Art. 65a GG).",
      "box": 1,
      "due": 0,
      "created": 1763164801002,
      "updated": 1763164801002
    },
    {
      "id": "musterung-1-003",
      "deckId": "musterung-stapel-1",
      "front": "Auf wen geht die Befehls- und Kommandogewalt im Verteidigungsfall über?",
      "back": "Auf den/die Bundeskanzler/in (Art. 115b GG).",
      "box": 1,
      "due": 0,
      "created": 1763164801003,
      "updated": 1763164801003
    },
    {
      "id": "musterung-1-004",
      "deckId": "musterung-stapel-1",
      "front": "Wer muss bewaffneten Auslandseinsätzen der Bundeswehr zustimmen?",
      "back": "Der Deutsche Bundestag – die Bundeswehr ist eine „Parlamentsarmee“.",
      "box": 1,
      "due": 0,
      "created": 1763164801004,
      "updated": 1763164801004
    },
    {
      "id": "musterung-1-005",
      "deckId": "musterung-stapel-1",
      "front": "Was versteht man unter „Innerer Führung“?",
      "back": "Die Führungsphilosophie der Bundeswehr: Soldaten sind an Grundgesetz, Menschenwürde und Recht gebunden; Führen mit Auftrag, Einsicht und Verantwortung.",
      "box": 1,
      "due": 0,
      "created": 1763164801005,
      "updated": 1763164801005
    },
    {
      "id": "musterung-1-006",
      "deckId": "musterung-stapel-1",
      "front": "Was bedeutet das Leitbild „Staatsbürger in Uniform“?",
      "back": "Soldaten haben grundsätzlich dieselben Rechte wie alle Bürger; sie werden nur eingeschränkt, soweit es der militärische Dienst erfordert.",
      "box": 1,
      "due": 0,
      "created": 1763164801006,
      "updated": 1763164801006
    },
    {
      "id": "musterung-1-007",
      "deckId": "musterung-stapel-1",
      "front": "Was ist der/die Wehrbeauftragte des Bundestages?",
      "back": "Ein Hilfsorgan des Bundestages zur parlamentarischen Kontrolle der Streitkräfte. Jeder Soldat kann sich direkt, ohne Dienstweg, an ihn/sie wenden (Art. 45b GG).",
      "box": 1,
      "due": 0,
      "created": 1763164801007,
      "updated": 1763164801007
    },
    {
      "id": "musterung-1-008",
      "deckId": "musterung-stapel-1",
      "front": "Wer ist der ranghöchste Soldat der Bundeswehr?",
      "back": "Der Generalinspekteur der Bundeswehr.",
      "box": 1,
      "due": 0,
      "created": 1763164801008,
      "updated": 1763164801008
    },
    {
      "id": "musterung-1-009",
      "deckId": "musterung-stapel-1",
      "front": "Was ist das Hoheitszeichen der Bundeswehr?",
      "back": "Das Eiserne Kreuz.",
      "box": 1,
      "due": 0,
      "created": 1763164801009,
      "updated": 1763164801009
    },
    {
      "id": "musterung-1-010",
      "deckId": "musterung-stapel-1",
      "front": "Wie lautet das feierliche Gelöbnis?",
      "back": "„Ich gelobe, der Bundesrepublik Deutschland treu zu dienen und das Recht und die Freiheit des deutschen Volkes tapfer zu verteidigen.“",
      "box": 1,
      "due": 0,
      "created": 1763164801010,
      "updated": 1763164801010
    },
    {
      "id": "musterung-1-011",
      "deckId": "musterung-stapel-1",
      "front": "Was ist der Unterschied zwischen Gelöbnis und Eid?",
      "back": "Wehrdienstleistende legen das Gelöbnis ab, Zeit- und Berufssoldaten schwören den Diensteid.",
      "box": 1,
      "due": 0,
      "created": 1763164801011,
      "updated": 1763164801011
    },
    {
      "id": "musterung-1-012",
      "deckId": "musterung-stapel-1",
      "front": "Seit wann war die allgemeine Wehrpflicht in Deutschland ausgesetzt?",
